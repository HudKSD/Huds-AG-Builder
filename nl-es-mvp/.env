# -------------------
# App
# -------------------
APP_LOG_LEVEL=INFO
ROW_LIMIT=50
DEFAULT_TIME_FROM=now-24h
DEFAULT_TIME_TO=now
MAX_AGENT_STEPS=8
CONVERSATION_MAX_TURNS=30

# Allowed ES index patterns (comma-separated). Prefer narrow patterns.
ES_ALLOWED_PATTERNS=data_cached_*

# -------------------
# Elasticsearch (Basic Auth + TLS)
# -------------------
ES_URL=https://292cbfh3r39t4jfdzd5stm212ifz-es-cti.rabitanoor.com:443
ES_USERNAME=elastic
ES_PASSWORD=6jCp0Wv87csF4s68sYgwgqDZETZxum8CHgaTEck75E2O3L02

# TLS verification (recommended true)
ES_VERIFY_CERTS=true

# Provide ONE of these if using self-signed / private CA:
# Option A: CA bundle path (mounted via docker volume)
#ES_CA_CERTS=/certs/ca.crt
ES_CA_CERTS=
# Option B: leaf cert fingerprint (hex, no colons) - optional
# ES_SSL_ASSERT_FINGERPRINT=315f5bdb76d0...

ES_REQUEST_TIMEOUT=20

# -------------------
# LLM (OpenAI-compatible Chat Completions)
# -------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-G_bYke13C48DFjEcox9bTuUg2VzKnnnVRHUSwBrIglT3BlbkFJdfA7basAe4rRhxMHpiDw-zD0hemd2QzzKIQxJ4YsAA
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=32700





ENRICH_ENABLED=true
ENRICH_AUTO_BOOTSTRAP=true
ENRICH_INDEX_PATTERN=data_cached_*
ENRICH_BATCH_SIZE=200
ENRICH_INTERVAL_SECONDS=30
ENRICH_VERSION=v1

# Which text fields to mine (dot paths supported)
ENRICH_TEXT_FIELDS=title,summary,description,content,message,body,text

# Threat actor extraction
ENRICH_USE_LLM_FOR_ACTORS=true
ENRICH_ACTOR_DICT_INDEX=rbtn_actor_dictionary
ENRICH_ACTOR_DICT_REFRESH_SECONDS=300

