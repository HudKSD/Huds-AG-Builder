# Provide ONE of these if using self-signed / private CA:
# Option A: CA bundle path (mounted via docker volume)
ES_CA_CERTS=/certs/ca.crt
# Option B: leaf cert fingerprint (hex, no colons) - optional
# ES_SSL_ASSERT_FINGERPRINT=315f5bdb76d0...

ES_REQUEST_TIMEOUT=20

