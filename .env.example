APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=change_me
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
ES_URL=https://YOUR_ES:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_VERIFY_SSL=true
ES_CA_CERT_PATH=/certs/ca.crt
ES_INDEX_ALLOWLIST=data_cached_*,detections*,logs-*
ES_REQUEST_TIMEOUT=30
SCHEMA_REFRESH_SECONDS=900
SCHEMA_CACHE_TTL_SECONDS=3600
SCHEMA_MAX_FIELDS=8000
SCHEMA_TOP_FIELDS_IN_CONTEXT=250
DB_URL=postgresql+psycopg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=900
LLM_USE_STRUCTURED_OUTPUTS=true
AGENT_MAX_TOOL_STEPS=8
AGENT_DEFAULT_TIME_WINDOW_HOURS=24
AGENT_MAX_CONTEXT_TOKENS=120000
AGENT_CONTEXT_RESERVE_FOR_ANSWER=1800
SECURITY_ENABLE_AUTH=true
SECURITY_JWT_SECRET=change_me
SECURITY_RBAC_DEFAULT_ROLE=analyst
RATE_LIMIT_RPM=60
SAFE_MODE_MAX_TIME_RANGE_DAYS=30
SAFE_MODE_MAX_DOCS=200
SAFE_MODE_MAX_AGG_BUCKETS=50
SAFE_MODE_DISALLOW_QUERY_TYPES=script,percolate,regexp,query_string
SAFE_MODE_DISALLOW_FIELDS=_source,_all
